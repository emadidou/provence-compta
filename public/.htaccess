# Provence Compta — une seule adresse par page pour Google.
# Serveur LiteSpeed / Apache (compatible mod_rewrite).

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. https + sans www  (www.provence-compta.com -> provence-compta.com)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^(.*)$ https://provence-compta.com/$1 [R=301,L]

  # 2. /index.html -> /   (et /dossier/index.html -> /dossier/)
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]

  # 3. Anciennes adresses du site d'origine
  RewriteRule ^SalonDeProvence/?$ /cabinets/salon-de-provence/ [R=301,L]
  RewriteRule ^Cavaillon/?$ /cabinets/cavaillon/ [R=301,L]
  RewriteRule ^LesAngles/?$ /cabinets/les-angles/ [R=301,L]
  RewriteRule ^LaSeyneSurMer/?$ /cabinets/la-seyne-sur-mer/ [R=301,L]
  RewriteRule ^QuiSommesNous/?$ /qui-sommes-nous/ [R=301,L]
  RewriteRule ^Mission/?$ /nos-missions/ [R=301,L]
  RewriteRule ^Contacts/?$ /contact/ [R=301,L]
  RewriteRule ^MentionsLegales/?$ /mentions-legales/ [R=301,L]
</IfModule>

# Page 404 personnalisée
ErrorDocument 404 /404.html

# Mise en cache des fichiers statiques
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
