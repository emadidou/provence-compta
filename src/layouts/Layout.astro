---
// Polices auto-hébergées (sous-ensemble latin : couvre accents, œ, €, apostrophe typographique).
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-700.css';
import '@fontsource/lora/latin-500.css';
import '@fontsource/lora/latin-600.css';
import '@fontsource/lora/latin-700.css';
import interRegular from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import loraSemibold from '@fontsource/lora/files/lora-latin-600-normal.woff2?url';
import '../styles/global.css';
import SEO from '@components/SEO.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import ContactBanner from '@components/ContactBanner.astro';
import CookieConsent from '@components/CookieConsent.astro';
import { site } from '@data/site';

interface Props {
  title: string;
  description?: string;
  path?: string;
  image?: string;
  noindex?: boolean;
  showContactBanner?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  path = Astro.url.pathname,
  image,
  noindex,
  showContactBanner = true,
  jsonLd,
} = Astro.props;

// Organisation JSON-LD injecté sur toutes les pages
const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AccountingService',
  '@id': `${site.url}/#organization`,
  name: site.legalName,
  description: site.description,
  url: site.url,
  logo: `${site.url}/images/logo.png`,
  telephone: site.phone,
  email: site.email,
  priceRange: '€€',
  openingHours: 'Mo-Fr 08:30-17:30',
  sameAs: site.sameAs,
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: site.phone,
    email: site.email,
    contactType: 'customer service',
    areaServed: 'FR',
    availableLanguage: ['fr'],
  },
  areaServed: 'Provence',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '355 boulevard Ledru Rollin',
    addressLocality: 'Salon-de-Provence',
    postalCode: '13300',
    addressCountry: 'FR',
  },
};

const ld = jsonLd ? [orgJsonLd, ...(Array.isArray(jsonLd) ? jsonLd : [jsonLd])] : orgJsonLd;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0B2545" />
    <meta name="generator" content={Astro.generator} />

    <!-- Polices hébergées sur le site (plus de Google Fonts) : préchargement des deux plus utilisées. -->
    <link rel="preload" href={interRegular} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={loraSemibold} as="font" type="font/woff2" crossorigin />

    <SEO title={title} description={description} path={path} image={image} noindex={noindex} jsonLd={ld} />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-navy focus:px-4 focus:py-2 focus:text-white"
    >
      Aller au contenu principal
    </a>

    <Header />

    <main id="main">
      <slot />
    </main>

    {showContactBanner && <ContactBanner />}

    <Footer />

    <CookieConsent />

    <script>
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!prefersReducedMotion) {
        const selectors = [
          'main section',
          'main h1',
          'main h2',
          'main h3',
          'main .eyebrow',
          'main p',
          'main article',
          'main form',
          'main input',
          'main textarea',
          'main label',
          'main .btn-primary',
          'main .btn-secondary',
          'main .btn-ghost-light',
          'main img',
          'main picture',
          'main iframe',
          'main li',
          'footer > div',
          'footer a',
          'footer p',
          'footer li',
        ];

        const elements = Array.from(document.querySelectorAll(selectors.join(',')))
          .filter((element) => !element.closest('header'))
          .filter((element, index, list) => list.indexOf(element) === index);

        elements.forEach((element, index) => {
          const tagName = element.tagName.toLowerCase();
          const isMedia = tagName === 'img' || tagName === 'picture' || tagName === 'iframe';
          const isLeftColumn = index % 3 === 1;
          const isRightColumn = index % 3 === 2;

          element.setAttribute(
            'data-animate',
            isMedia ? 'zoom-in' : isLeftColumn ? 'fade-right' : isRightColumn ? 'fade-left' : 'fade-up'
          );
          element.style.setProperty('--reveal-delay', `${Math.min(index % 8, 7) * 45}ms`);
        });

        document.documentElement.classList.add('motion-ready');

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
        );

        elements.forEach((element) => observer.observe(element));
      }
    </script>
  </body>
</html>
