---
import Icon from './Icon.astro';
---
<section class="relative isolate overflow-hidden">
  <div
    class="absolute inset-0 -z-10 bg-cover bg-center"
    style="background-image:url('/images/heroes/contact-banner.webp')"
    aria-hidden="true"
  ></div>
  <div class="absolute inset-0 -z-10 bg-navy-800/88" aria-hidden="true"></div>

  <div class="container-px py-16 md:py-20">
    <div class="flex flex-col items-center gap-7 text-center">
      <div>
        <h2 class="font-serif text-2xl font-semibold text-white sm:text-3xl">
          Besoin de plus d’informations ?
        </h2>
        <p class="mt-3 text-sm uppercase tracking-[0.18em] text-white/70">
          Nous sommes à votre disposition pour toute demande
        </p>
      </div>

      <div class="flex flex-col gap-3 sm:flex-row">
        <a href="/contact/" class="btn-primary">
          <Icon name="mail" class="h-4 w-4" />
          Nous contacter
        </a>
      </div>
    </div>
  </div>
</section>
