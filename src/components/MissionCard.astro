---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { Mission } from '@data/missions';
interface Props { mission: Mission; href?: string; }
const { mission, href = `/nos-missions/${mission.slug}/` } = Astro.props;
---
<article class="group flex flex-col overflow-hidden rounded-xl border border-line bg-white shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-card-hover">
  <div class="relative h-44 overflow-hidden">
    <Image
      src={mission.image}
      alt={mission.title}
      width={640}
      height={360}
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-navy-900/55 to-transparent"></div>
    <span class="absolute left-4 top-4 inline-flex h-11 w-11 items-center justify-center rounded-lg bg-white/95 text-accent shadow-soft">
      <Icon name={mission.icon} class="h-5 w-5" />
    </span>
  </div>
  <div class="flex flex-1 flex-col p-6">
    <p class="text-xs font-semibold uppercase tracking-[0.14em] text-accent">{mission.highlight}</p>
    <h3 class="mt-2.5 text-xl font-semibold text-navy">{mission.title}</h3>
    <p class="mt-3 flex-1 text-[15px] leading-7 text-slate-600">{mission.description}</p>
    <a href={href} class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-accent transition-colors hover:text-accent-700">
      En savoir plus
      <Icon name="arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
    </a>
  </div>
</article>
