---
import Icon from './Icon.astro';
import type { Sector } from '@data/sectors';
interface Props { sector: Sector; }
const { sector } = Astro.props;
---
<a
  href={`/profils/${sector.slug}/`}
  class="group flex flex-col rounded-xl border border-line bg-white p-6 shadow-card transition-all duration-300 hover:-translate-y-1 hover:border-accent/40 hover:shadow-card-hover focus-visible:outline-none"
>
  <span class="inline-flex h-12 w-12 items-center justify-center rounded-lg bg-accent/10 text-accent transition-colors group-hover:bg-accent group-hover:text-white">
    <Icon name={sector.icon} class="h-6 w-6" />
  </span>
  <h3 class="mt-5 text-lg font-semibold text-navy">{sector.label}</h3>
  <p class="mt-2 flex-1 text-sm leading-6 text-slate-600">{sector.shortDescription}</p>
  <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-accent">
    Voir l’accompagnement
    <Icon name="arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
  </span>
</a>
