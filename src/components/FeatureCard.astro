---
import Icon from './Icon.astro';
interface Props {
  title: string;
  description?: string;
  icon?: string;
  number?: string;
}
const { title, description, icon, number } = Astro.props;
---
<article class="rounded-xl border border-line bg-white p-6 shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-card-hover">
  {icon && (
    <span class="inline-flex h-11 w-11 items-center justify-center rounded-lg bg-accent/10 text-accent">
      <Icon name={icon} class="h-5 w-5" />
    </span>
  )}
  {number && (
    <span class="inline-flex h-11 w-11 items-center justify-center rounded-lg bg-navy text-base font-semibold text-white">
      {number}
    </span>
  )}
  <h3 class={`text-lg font-semibold text-navy ${icon || number ? 'mt-5' : ''}`}>{title}</h3>
  {description && <p class="mt-2.5 text-[15px] leading-7 text-slate-600">{description}</p>}
  <slot />
</article>
